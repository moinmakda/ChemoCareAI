  "toxicities": [
    {
      "drug_id": "rituximab",
      "adverse_effects": [
        "Infusion reactions (CRS, fever, chills, urticaria)",
        "Progressive multifocal leukoencephalopathy (PML — rare)",
        "Hepatitis B reactivation",
        "Immunosuppression",
        "Hypogammaglobulinaemia"
      ]
    },
    {
      "drug_id": "gemcitabine",
      "adverse_effects": [
        "Myelosuppression",
        "Flu-like syndrome",
        "Nausea",
        "Hepatotoxicity (transaminase rise)",
        "Rash",
        "Peripheral oedema",
        "Radiosensitisation"
      ]
    },
    {
      "drug_id": "oxaliplatin",
      "adverse_effects": [
        "Cumulative peripheral neuropathy",
        "Acute cold-induced laryngopharyngeal dysaesthesia",
        "Nausea and vomiting",
        "Myelosuppression",
        "Extravasation injury (exfoliant)",
        "Allergic reactions"
      ]
    }
  ],
