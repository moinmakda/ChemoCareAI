  "toxicities": [
    {
      "drug_id": "rituximab",
      "adverse_effects": [
        "Infusion reactions (fever, chills, urticaria, angioedema, CRS)",
        "Progressive multifocal leukoencephalopathy (PML — rare)",
        "Hepatitis B reactivation",
        "Immunosuppression",
        "Hypogammaglobulinaemia"
      ]
    },
    {
      "drug_id": "bendamustine",
      "adverse_effects": [
        "Myelosuppression (neutropenia, thrombocytopenia)",
        "Nausea and vomiting",
        "Fatigue",
        "Infection (including opportunistic infections)",
        "Extravasation injury (vesicant)",
        "Skin reactions (rash, Stevens-Johnson syndrome — rare with allopurinol co-administration)",
        "Tumour lysis syndrome",
        "Transfusion-associated graft-versus-host disease (TA-GVHD) — irradiated blood products required for life"
      ]
    }
  ],
  "monitoring": [
    "FBC, renal function, and LFTs before each cycle",
    "Rituximab infusion vital signs monitoring (temperature, BP, pulse, O2 sats) during every infusion",
    "Hepatitis B monitoring if positive serology detected — expert review required",
    "Monitor for neurological or cognitive symptoms (PML risk with rituximab)",
    "Monitor for tumour lysis syndrome — especially cycle 1",
    "Monitor skin reactions if allopurinol co-administered with bendamustine (SJS risk)"
  ],
  "warnings": [
    "Check hepatitis B status before starting rituximab — risk of fatal reactivation.",
    "Risk of progressive multifocal leukoencephalopathy (PML) with rituximab — monitor for neurological symptoms.",
    "Cytokine release syndrome risk with rituximab — most common during first infusion.",
    "Bendamustine is a VESICANT — use caution with peripheral cannulae; central venous access preferred for repeated cycles.",
    "PCP prophylaxis with co-trimoxazole 960mg three times weekly is mandatory for the duration of treatment.",
    "Consider antiviral prophylaxis (aciclovir 400mg BD) for herpes reactivation.",
    "Rituximab dose reductions are NOT permitted.",
    "Monitor for tumour lysis syndrome — especially cycle 1.",
    "Bendamustine — avoid mixing with other drugs; flush line thoroughly before and after.",
    "CAUTION: Concomitant allopurinol with bendamustine significantly increases risk of severe skin reactions including Stevens-Johnson syndrome (SJS) and toxic epidermal necrolysis. Avoid co-administration where possible.",
    "Bendamustine metabolism involves cytochrome P450 (CYP) 1A2 isoenzyme. Potential for interaction with CYP1A2 inhibitors such as fluvoxamine, ciprofloxacin, aciclovir and cimetidine exists."
  ],
