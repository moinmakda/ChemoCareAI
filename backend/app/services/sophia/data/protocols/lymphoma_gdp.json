  "toxicities": [
    {
      "drug_id": "cisplatin",
      "adverse_effects": [
        "Nephrotoxicity",
        "Ototoxicity",
        "Nausea and vomiting (highly emetogenic)",
        "Peripheral neuropathy",
        "Myelosuppression",
        "Hypomagnesaemia",
        "Hyponatraemia",
        "Extravasation injury (exfoliant)"
      ]
    },
    {
      "drug_id": "gemcitabine",
      "adverse_effects": [
        "Myelosuppression",
        "Flu-like syndrome",
        "Nausea",
        "Hepatotoxicity (transaminase rise)",
        "Rash",
        "Peripheral oedema"
      ]
    },
    {
      "drug_id": "dexamethasone",
      "adverse_effects": [
        "Hyperglycaemia",
        "Insomnia",
        "Mood disturbance",
        "GI disturbance",
        "Immunosuppression"
      ]
    }
  ],
  "monitoring": [
    "FBC, U&Es, LFTs, and blood glucose before each cycle and before day 8",
    "EDTA creatinine clearance before each cycle — cisplatin dose reduced to 75% if CrCl 40-59, omitted if CrCl <40 ml/min",
    "Audiological assessment if ototoxicity suspected",
    "Adequate hydration monitoring — patient must drink ≥3 litres per day after cisplatin"
  ],
  "warnings": [
    "Hodgkin Lymphoma patients carry a LIFELONG risk of TA-GVHD. IRRADIATED blood products must be used for life. Notify transfusion department immediately and issue patient alert card.",
    "Cisplatin is highly emetogenic — triple antiemetic prophylaxis with aprepitant, 5-HT3 antagonist, and dexamethasone required.",
    "Cisplatin nephrotoxicity: EDTA or calculated CrCl required before day 1. Reduce to 75% if CrCl 40-59, omit if CrCl <40 ml/min.",
    "Adequate pre- and post-cisplatin hydration mandatory. Patients must drink ≥3 litres of fluid per 24 hours after cisplatin.",
    "Monitor electrolytes carefully — cisplatin causes hypomagnesaemia and hypokalaemia.",
    "Cisplatin is ototoxic — consider formal audiology testing.",
    "Cisplatin extravasation risk: classified as exfoliant.",
    "Regular blood glucose monitoring required due to high-dose dexamethasone.",
    "Protocol permits 3 to 6 cycles (3 cycles set in ARIA). Clinical decision for additional cycles."
