      "adverse_effects": [
        "Myelosuppression",
        "Haemorrhagic cystitis",
        "Nausea and vomiting",
        "Alopecia",
        "Immunosuppression",
        "Secondary malignancy (rare)"
      ]
    },
    {
      "drug_id": "vincristine",
