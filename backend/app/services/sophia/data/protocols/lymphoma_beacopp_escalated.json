      "drug_id": "etoposide",
      "adverse_effects": [
        "Myelosuppression (dose-limiting)",
        "Nausea and vomiting",
        "Alopecia",
        "Hypotension during infusion",
        "Secondary malignancy (AML — rare)",
        "Mucositis"
      ]
    },
    {
      "drug_id": "doxorubicin",
      "adverse_effects": [
        "Cardiotoxicity (cardiomyopathy — cumulative dose-dependent)",
        "Myelosuppression",
        "Nausea and vomiting",
        "Alopecia",
        "Extravasation injury (vesicant)",
        "Mucositis"
      ]
    },
    {
