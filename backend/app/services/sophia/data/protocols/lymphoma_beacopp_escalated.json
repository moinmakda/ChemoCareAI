  "toxicities": [
    {
      "drug_id": "bleomycin",
      "adverse_effects": [
        "Pulmonary toxicity (pneumonitis, fibrosis — dose-limiting)",
        "Skin hyperpigmentation and thickening",
        "Fever and chills",
        "Alopecia",
        "Mucositis",
        "Raynaud's phenomenon"
      ]
    },
